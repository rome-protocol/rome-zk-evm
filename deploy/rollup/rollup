#!/usr/bin/env bash
# rollup — run a rollup node on one machine. Needs bash, docker with the compose plugin (Engine 28 or newer), curl,
# jq, openssl and python3 (3.11 or newer). No Rust, no cargo: every operator action on Solana runs inside the node
# image (rome-zk-ops). It reaches no cloud service: every file it reads is local, every request it makes goes to your
# own containers or to the Solana RPC endpoint you configured.
#
#   ./rollup init                       read your chain id from Solana, render every config with it (from chain.toml,
#                                       .env and the programs file)
#   ./rollup register --dry-run         print the registration commands without running anything
#   ./rollup register --confirm         register the chain on Solana (no verifier keys) and write rendered/pdas.env
#   ./rollup guest-build [--skip-program-vk]   build the batch guest for rendered/genesis.json into rendered/guest/
#   ./rollup up [service...]            start the node (the prover too when PROVER=on)
#   ./rollup down                       stop and remove the containers; the data volumes stay
#   ./rollup logs [-f] [--tail N] [service...]   the services' logs
#   ./rollup status                     the running services and what Solana says about the chain
#   ./rollup check                      health check: services, chain id, heads, batches, roots, derive, key, payer
#   ./rollup refund-deposit             give the registration deposit back to the chain authority
#   ./rollup exit-config propose|activate|show   change or read the chain's exit configuration
#   ./rollup vault init|fund|show       the chain's bridge vault
#   ./rollup release-exit --message-hash 0x...   release a proved exit from the vault
#   ./rollup migrate --registry-keypair FILE --max-drift-secs N   bring an older chain forward (registry authority)
#
# Commands that send a Solana transaction (register, refund-deposit, exit-config propose and activate, vault init and
# fund, release-exit, migrate) are a dry run unless you pass --confirm: they read the chain, print the transaction and
# send nothing. --offline is a dry run with no network at all.
#
# Where things live (each can be overridden by an environment variable of the same name):
#   ROLLUP_ENV   the machine's settings        default deploy/rollup/.env
#   CHAIN_TOML   the chain's settings          default deploy/rollup/chain.toml
#   ROLLUP_OUT   what init renders             default deploy/rollup/rendered
#
# Every refusal starts with a CamelCase name, written to stderr, and exits non-zero.
set -uo pipefail

ROLLUP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$ROLLUP_DIR/../.." && pwd)"
# shellcheck source=lib/config-lib.sh
source "$ROLLUP_DIR/lib/config-lib.sh"

abs() { case "$1" in /*) printf '%s' "$1" ;; *) printf '%s' "$ROLLUP_DIR/${1#./}" ;; esac; }
ENV_FILE="$(abs "${ROLLUP_ENV:-$ROLLUP_DIR/.env}")"
CHAIN_TOML="$(abs "${CHAIN_TOML:-$ROLLUP_DIR/chain.toml}")"
OUT="$(abs "${ROLLUP_OUT:-$ROLLUP_DIR/rendered}")"

die() { echo "$1: $2" >&2; exit 1; }

# cfg KEY [DEFAULT] -> the process environment wins, then the .env file, then the default.
cfg() {
  local key="$1" def="${2:-}" v="${!1:-}"
  [[ -n "$v" ]] || v="$(rz_env_get "$ENV_FILE" "$key")"
  printf '%s' "${v:-$def}"
}

# Where the node's own ports are, on this machine. The host side of each port comes from the same settings the
# compose file reads (see .env.example), with today's numbers as the defaults.
RPC_PORT="$(cfg RPC_PORT 8545)"
WS_PORT="$(cfg WS_PORT 8546)"
VERIFIER_RPC_PORT="$(cfg VERIFIER_RPC_PORT 8547)"
SEQUENCER_METRICS_PORT="$(cfg SEQUENCER_METRICS_PORT 9001)"
BATCHER_METRICS_PORT="$(cfg BATCHER_METRICS_PORT 9002)"
DERIVE_METRICS_PORT="$(cfg DERIVE_METRICS_PORT 9003)"
PROVER_METRICS_PORT="$(cfg PROVER_METRICS_PORT 9004)"
PORT_VARS=(RPC_PORT WS_PORT VERIFIER_RPC_PORT SEQUENCER_METRICS_PORT BATCHER_METRICS_PORT DERIVE_METRICS_PORT PROVER_METRICS_PORT)
for _v in "${PORT_VARS[@]}"; do
  [[ "${!_v}" =~ ^[0-9]+$ && "${!_v}" -ge 1 && "${!_v}" -le 65535 ]] || die PortInvalid "$_v is '${!_v}', expected a port number from 1 to 65535"
done
SEQUENCER_RPC="http://127.0.0.1:$RPC_PORT"
VERIFIER_RPC="http://127.0.0.1:$VERIFIER_RPC_PORT"
METRICS_SEQUENCER="http://127.0.0.1:$SEQUENCER_METRICS_PORT/metrics"
METRICS_BATCHER="http://127.0.0.1:$BATCHER_METRICS_PORT/metrics"
METRICS_PROVER="http://127.0.0.1:$PROVER_METRICS_PORT/metrics"

load_env() {
  [[ -f "$ENV_FILE" ]] || die EnvMissing "$ENV_FILE does not exist (copy .env.example to .env and edit it)"
  SOLANA_RPC_URL="$(cfg SOLANA_RPC_URL)"
  [[ -n "$SOLANA_RPC_URL" ]] || die SolanaRpcUrlMissing "SOLANA_RPC_URL is not set in $ENV_FILE"
}

load_programs() {
  PROGRAMS="$(abs "$(cfg PROGRAMS_JSON programs.devnet.json)")"
  [[ -f "$PROGRAMS" ]] || die ProgramsFileMissing "$PROGRAMS does not exist (set PROGRAMS_JSON in $ENV_FILE to the published program-address file for your cluster)"
  local name val
  CLUSTER="$(jq -r '.cluster // empty' "$PROGRAMS" 2>/dev/null)"
  INBOX_ID="$(jq -r '.programs["zk-inbox"] // empty' "$PROGRAMS" 2>/dev/null)"
  SETTLEMENT_ID="$(jq -r '.programs["zk-settlement"] // empty' "$PROGRAMS" 2>/dev/null)"
  BRIDGE_ID="$(jq -r '.programs["zk-bridge"] // empty' "$PROGRAMS" 2>/dev/null)"   # only the vault and exit commands need it
  for name in CLUSTER INBOX_ID SETTLEMENT_ID; do
    val="${!name}"
    [[ -n "$val" ]] || die ProgramsFileInvalid "$PROGRAMS has no value for $name (expected cluster, programs.zk-inbox and programs.zk-settlement)"
  done
}

require_init() {
  [[ -f "$OUT/genesis.json" && -f "$OUT/compose.env" ]] || die NotInitialised "nothing rendered under $OUT (run ./rollup init first)"
}

# The largest chain id MetaMask accepts when a user adds a network: MAX_SAFE_CHAIN_ID in MetaMask's
# shared/constants/network.ts (metamask-extension; core's controller-utils isSafeChainId checks the same bound).
# Other wallets that follow it refuse a larger id too.
MAX_WALLET_SAFE_CHAIN_ID=4503599627370476

# ------------------------------------------------------------------------------------------ rome-zk-ops in the node image
# Every operator action on Solana is one `rome-zk-ops` command run from the node image the .env names (the same image
# ./rollup up starts), so the host needs no Rust. Each key file is bind-mounted read-only by its path and the command
# gets the path inside the container: a key's contents are never read, printed or passed on a command line. The
# container runs on the host's network so a Solana RPC on this machine and the sequencer's published port are reachable.
OPS_MOUNTS=()
ops_reset() { OPS_MOUNTS=(); }
mount_key() { # $1=name inside the container $2=host path -> REPLY is the path inside the container
  [[ "$2" != *,* ]] || die KeyPathInvalid "$2 has a comma in it, which a bind mount cannot take; move the key file"
  [[ -f "$2" ]] || die KeyFileMissing "$2 does not exist (a Solana keypair file; it is mounted read-only into the container and never printed)"
  OPS_MOUNTS+=(--mount "type=bind,source=$2,target=/keys/$1,readonly")
  REPLY="/keys/$1"
}
# The image: the one compose runs (rendered/compose.env), or while init is still rendering it, the one the .env names.
node_image() { # [cfg] -> the image reference, or non-zero when none is set
  local img="" tag=""
  if [[ "${1:-}" != cfg && -f "$OUT/compose.env" ]]; then
    img="$(rz_env_get "$OUT/compose.env" ROME_ZK_IMAGE)"; tag="$(rz_env_get "$OUT/compose.env" ROME_ZK_TAG)"
  else
    img="$(cfg ROME_ZK_IMAGE)"; tag="$(cfg ROME_ZK_TAG)"
  fi
  if [[ -n "$img" ]]; then printf '%s' "$img"
  elif [[ -n "$tag" ]]; then printf 'ghcr.io/rome-protocol/rome-zk-evm:%s' "$tag"
  else return 1; fi
}
need_image() { # sets OPS_IMAGE or refuses by name
  OPS_IMAGE="$(node_image "${1:-}")" || die ImageTagNotSet "set ROME_ZK_TAG in $ENV_FILE to the tag of the source you checked out (published tags: https://github.com/rome-protocol/rome-zk-evm/tags), or ROME_ZK_IMAGE to an image you built; the operator commands run from that image"
}
ops() { # ops ARGS... -> runs rome-zk-ops from the node image against SOLANA_RPC_URL; the mounts are OPS_MOUNTS
  docker run --rm --network host ${OPS_MOUNTS[@]+"${OPS_MOUNTS[@]}"} --entrypoint rome-zk-ops "$OPS_IMAGE" --rpc-url "$SOLANA_RPC_URL" "$@"
}

# The chain id is not chosen. A permissionless id is derived by the settlement program from the payer's key and the
# number of chains that payer has registered so far, so it is read from Solana: rome-zk-ops chain-id prints it and
# sends nothing. Sets D_AUTHORITY, D_NONCE and D_ID.
fetch_chain_id() {
  local payer="$1" out errf
  [[ -f "$payer" ]] || die PayerKeyMissing "$payer does not exist (a funded Solana keypair; set PAYER_KEYPAIR_PATH in $ENV_FILE). Your chain id comes from this key."
  need_image "${2:-}"
  ops_reset; mount_key payer "$payer"
  errf="$(mktemp)"
  if ! out="$(ops chain-id --settlement "$SETTLEMENT_ID" --keypair "$REPLY" 2>"$errf")"; then
    tail -5 "$errf" >&2; rm -f "$errf"
    die ChainIdLookupFailed "could not read the registration nonce for $payer from $SOLANA_RPC_URL"
  fi
  rm -f "$errf"
  D_AUTHORITY="$(sed -n 's/^authority=//p' <<<"$out" | head -1)"
  D_NONCE="$(sed -n 's/^nonce=//p' <<<"$out" | head -1)"
  D_ID="$(sed -n 's/^chain_id=//p' <<<"$out" | head -1)"
  [[ -n "$D_AUTHORITY" && "$D_NONCE" =~ ^[0-9]+$ && "$D_ID" =~ ^[0-9]+$ ]] || die ChainIdLookupFailed "unexpected output from the chain-id command: $out"
  (( D_ID >= 4294967296 )) || die ChainIdInvalid "the derived chain id $D_ID is below 2^32, which a permissionless registration cannot produce"
}

# ---------------------------------------------------------------------------------------------------------- init
cmd_init() {
  load_env
  [[ -f "$CHAIN_TOML" ]] || die ChainTomlMissing "$CHAIN_TOML does not exist (copy chain.toml.example to chain.toml and edit it)"
  load_programs
  local example="${SEQUENCER_EXAMPLE_CONFIG:-$REPO_ROOT/crates/rome-zk-sequencer/config.example.toml}"

  local errf vals chosen fee_recipient close_after
  errf="$(mktemp)"
  if ! vals="$(rz_toml_get "$CHAIN_TOML" chain_id batcher.batch_close_after_secs genesis.fee_recipient 2>"$errf")"; then
    local err; err="$(tail -1 "$errf")"; rm -f "$errf"
    case "$err" in Python311Required*) echo "$err" >&2; exit 1 ;; *) die ChainTomlInvalid "$CHAIN_TOML: $err" ;; esac
  fi
  rm -f "$errf"
  chosen="$(sed -n 1p <<<"$vals")"; close_after="$(sed -n 2p <<<"$vals")"
  fee_recipient="$(sed -n 3p <<<"$vals")"
  [[ -z "$chosen" ]] || die ChainIdNotChosen "chain_id in $CHAIN_TOML must be removed: a permissionless chain id is derived from your payer key and its registration count, and init reads it from Solana"
  # A genesis that mints coins for one address can never take deposits safely: its holder could exit coins that other people's
  # deposits paid for, and the genesis cannot change once registered. So there is no funded address any more; a genesis has
  # no balances unless one backed balance is declared below.
  [[ "$(rz_toml_kind "$CHAIN_TOML" genesis.funded_address)" == absent ]] || die FundedAddressRemoved "genesis.funded_address in $CHAIN_TOML is no longer supported: a genesis that mints coins can never take deposits safely, so a new chain starts with no balances. Remove it. If you need gas before deposits are available, declare one backed balance instead: genesis.backed_address and genesis.backed_balance_lamports (lock the same amount in your chain's vault before Rome registers your key)."
  local gkey
  while IFS= read -r gkey; do
    case "$gkey" in
      fee_recipient|backed_address|backed_balance_lamports) ;;
      *) die GenesisKeyUnknown "[genesis] $gkey in $CHAIN_TOML is not a setting (allowed: fee_recipient, backed_address, backed_balance_lamports). A balance is written backed_balance_lamports, in lamports." ;;
    esac
  done < <(rz_toml_keys "$CHAIN_TOML" genesis)
  # The fee recipient becomes the genesis coinbase: the sequencer, derive and the guest all read the chain's fee recipient
  # from it, and it cannot change once the chain is registered. The same reserved addresses would hold the fees where
  # nobody can spend them.
  [[ -n "$fee_recipient" ]] || die FeeRecipientMissing "genesis.fee_recipient is not set in $CHAIN_TOML: it is the address that receives the priority fees (tips) of the chain's transactions, and it cannot be changed after you register. Use an address you control."
  [[ "$fee_recipient" =~ ^0x[0-9a-fA-F]{40}$ ]] || die FeeRecipientInvalid "genesis.fee_recipient in $CHAIN_TOML must be 0x followed by 40 hex characters (got '$fee_recipient')"
  local fee_lc="${fee_recipient,,}"
  if [[ "$fee_lc" =~ ^0x0{38}[0-9a-f]{2}$ ]]; then
    die FeeRecipientReserved "genesis.fee_recipient in $CHAIN_TOML is $fee_recipient, a precompile address (or zero): the fees sent there are lost. Use an address you control."
  fi
  [[ "$fee_lc" != 0x4200000000000000000000000000000000000016 ]] || die FeeRecipientReserved "genesis.fee_recipient in $CHAIN_TOML is the exit portal's address; use an address you control."
  [[ "$close_after" =~ ^[1-9][0-9]*$ ]] || die BatchCloseAfterInvalid "batcher.batch_close_after_secs in $CHAIN_TOML must be a positive integer (got '$close_after')"

  # An optional backed balance: one address that holds G at genesis, where G is locked in the chain's vault with zk-bridge
  # Fund before Rome registers the key. The amount is written in lamports (wrapped SOL: 1 lamport = 1 gwei) and rendered as
  # wei = lamports x 1e9, so it converts exactly into the vault mint's base units.
  local backed="" backed_lamports="" backed_wei="" backed_alloc=""
  local backed_addr_kind backed_bal_kind
  backed_addr_kind="$(rz_toml_kind "$CHAIN_TOML" genesis.backed_address)"
  backed_bal_kind="$(rz_toml_kind "$CHAIN_TOML" genesis.backed_balance_lamports)"
  if [[ "$backed_addr_kind" != absent || "$backed_bal_kind" != absent ]]; then
    backed="$(rz_toml_get "$CHAIN_TOML" genesis.backed_address)"
    [[ -n "$backed" ]] || die BackedAddressMissing "genesis.backed_address is missing or empty in $CHAIN_TOML while a backed balance key is present: name the address that holds the backed balance, or remove both keys for a genesis with no balances."
    [[ "$backed_bal_kind" != absent ]] || die BackedBalanceMissing "genesis.backed_address is set in $CHAIN_TOML but genesis.backed_balance_lamports is not: give the amount in lamports (a whole number), or remove both keys for a genesis with no balances."
    [[ "$backed_addr_kind" == str && "$backed" =~ ^0x[0-9a-fA-F]{40}$ ]] || die BackedAddressInvalid "genesis.backed_address in $CHAIN_TOML must be 0x followed by 40 hex characters (got '$backed')"
    local backed_lc="${backed,,}"
    if [[ "$backed_lc" =~ ^0x0{38}[0-9a-f]{2}$ ]]; then
      die BackedAddressReserved "genesis.backed_address in $CHAIN_TOML is $backed, a precompile address (or zero): nobody can spend from it. Use an address you control."
    fi
    [[ "$backed_lc" != 0x4200000000000000000000000000000000000016 ]] || die BackedAddressReserved "genesis.backed_address in $CHAIN_TOML is the exit portal's address; use an address you control."
    backed_lamports="$(rz_toml_get "$CHAIN_TOML" genesis.backed_balance_lamports)"
    if [[ "$backed_bal_kind" != int ]] || grep -qE '^[[:space:]]*"?backed_balance_lamports"?[[:space:]]*=[[:space:]]*0[xob]' "$CHAIN_TOML" \
       || ! backed_wei="$(rz_lamports_to_wei_hex "$backed_lamports")"; then
      die BackedBalanceInvalid "genesis.backed_balance_lamports in $CHAIN_TOML must be a whole number of lamports from 1 to 18446744073709551615, written as a plain integer such as 1_500_000_000 for 1.5 SOL (got '$backed_lamports'; no decimals, quotes, units, hex or exponents)"
    fi
    backed_alloc=", \"$backed\": { \"balance\": \"$backed_wei\" }"
  fi

  # [profile] becomes sequencer settings, one for one. A name the example config does not have is refused by name, and so
  # is a name init sets itself: it would override the derived chain id or move a path off the mounted volume.
  local profile_lines=() line k v
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    k="${line%%=*}"
    case "$k" in
      chain_id|rpc_addr|metrics_addr|log_dir|sequencer_key_path|datadir|genesis_path)
        die ProfileKeyReserved "[profile] $k in $CHAIN_TOML is set by init itself (reserved: chain_id, rpc_addr, metrics_addr, log_dir, sequencer_key_path, datadir, genesis_path); remove it" ;;
    esac
    profile_lines+=("$line")
  done < <(rz_toml_table "$CHAIN_TOML" profile)

  # Everything in chain.toml is checked; now the one network call: the chain id.
  local payer_key chain_id rec="$OUT/chain-id.env" rec_auth rec_nonce rec_id
  payer_key="$(abs "$(cfg PAYER_KEYPAIR_PATH ./keys/payer.json)")"
  fetch_chain_id "$payer_key" cfg
  local registered=0 fresh_nonce="$D_NONCE"
  [[ ! -f "$OUT/pdas.env" ]] || registered=1   # register writes pdas.env when it finishes
  if [[ -f "$rec" ]]; then
    # A chain id init recorded stays: registering moves the payer's nonce forward, and the id derived from the new nonce
    # would be another chain. The record holds only while the payer is the key that was recorded.
    rec_auth="$(rz_env_get "$rec" AUTHORITY)"; rec_nonce="$(rz_env_get "$rec" NONCE)"; rec_id="$(rz_env_get "$rec" CHAIN_ID)"
    [[ -n "$rec_auth" && "$rec_nonce" =~ ^[0-9]+$ && "$rec_id" =~ ^[0-9]+$ ]] || die ChainIdRecordInvalid "$rec has no valid AUTHORITY, NONCE and CHAIN_ID (move $OUT aside to start a new chain)"
    [[ "$D_AUTHORITY" == "$rec_auth" ]] || die AuthorityChanged "the payer key $payer_key is $D_AUTHORITY, but $rec records the chain's authority as $rec_auth; use that key again (PAYER_KEYPAIR_PATH in $ENV_FILE), or move $OUT aside to start a new chain"
    # Registering moves the payer's nonce, so a nonce past the recorded one means this chain was registered even if register
    # stopped before it wrote pdas.env.
    (( fresh_nonce > rec_nonce )) && registered=1
    D_NONCE="$rec_nonce"; D_ID="$rec_id"
  fi
  chain_id="$D_ID"
  # Wallets cannot add a chain id above the bound. Before registration the id can still be avoided by another payer key; after
  # it the id is permanent, so only say so.
  if (( chain_id > MAX_WALLET_SAFE_CHAIN_ID )); then
    if (( registered )); then
      echo "ChainIdNotWalletSafe (warning): this chain's id $chain_id is above $MAX_WALLET_SAFE_CHAIN_ID, so wallets like MetaMask cannot add it. This chain looks registered (rendered/pdas.env exists or the payer's nonce has moved), so its id cannot change; continuing." >&2
    else
      die ChainIdNotWalletSafe "the chain id $chain_id that your payer key would get is above $MAX_WALLET_SAFE_CHAIN_ID, so wallets like MetaMask cannot add this chain. Create a new payer key (solana-keygen new), point PAYER_KEYPAIR_PATH in $ENV_FILE at it, fund it, and run ./rollup init again (if $OUT already holds an earlier init, move it aside first); nothing has been sent."
    fi
  fi

  local pairs=()
  pairs+=("chain_id=$chain_id" 'rpc_addr="0.0.0.0:9944"' 'metrics_addr="0.0.0.0:9001"' 'log_dir="/data/reth/log"'
          'sequencer_key_path="/data/sequencer.key"' 'datadir="/data/reth/db"' 'genesis_path="/data/genesis.json"')
  for line in ${profile_lines[@]+"${profile_lines[@]}"}; do
    k="${line%%=*}"; v="${line#*=}"
    [[ "$v" =~ ^[0-9]+$ ]] || v="\"$v\""
    pairs+=("$k=$v")
  done

  STAGE="$(mktemp -d)"
  trap 'rm -rf "$STAGE"' EXIT
  rz_render_sequencer_config "$example" "$STAGE/sequencer-config.toml" "${pairs[@]}" || exit 1

  local gas_limit gas_hex blocks_per_batch
  gas_limit="$(rz_profile_gas_limit "$STAGE/sequencer-config.toml")" || die ProfileInvalid "sub_block_gas_limit and sub_blocks_per_block must be set in [profile]"
  gas_hex="$(printf '0x%x' "$gas_limit")"
  blocks_per_batch="$(rz_config_value "$STAGE/sequencer-config.toml" blocks_per_batch)"

  # The exit portal is a predeploy at 0x42..16, the same bytecode every chain starts with. Exiting funds also needs the
  # settlement program's exit configuration to name it; that is set later, by the program's governance.
  local portal_hex portal_file="${EXIT_PORTAL_RUNTIME_HEX:-$REPO_ROOT/contracts/exit-portal/RomeExitPortal.runtime.hex}"
  portal_hex="$(rz_hex_body "$portal_file" 2>/dev/null)" || die ExitPortalRuntimeMissing "$portal_file is absent, empty or not valid hex (run from a full checkout)"
  rz_render_template "$ROLLUP_DIR/genesis.json.template" "$STAGE/genesis.json" \
    "CHAIN_ID=$chain_id" "GAS_LIMIT_HEX=$gas_hex" "BACKED_ALLOC=$backed_alloc" "FEE_RECIPIENT=$fee_recipient" "EXIT_PORTAL_RUNTIME=$portal_hex" || exit 1
  local common=("CHAIN_ID=$chain_id" "CLUSTER=$CLUSTER" "INBOX_PROGRAM_ID=$INBOX_ID" "SETTLEMENT_PROGRAM_ID=$SETTLEMENT_ID"
                "SOLANA_RPC_URL=$SOLANA_RPC_URL" "BATCH_CLOSE_AFTER_SECS=$close_after" "BLOCKS_PER_BATCH=$blocks_per_batch")
  rz_render_template "$ROLLUP_DIR/batcher.toml.template" "$STAGE/batcher.toml" "${common[@]}" || exit 1
  rz_render_template "$ROLLUP_DIR/derive.toml.template" "$STAGE/derive.toml" "${common[@]}" || exit 1

  # The prover is required for settlement; when enabled, its inputs are checked before anything is written.
  local prover; prover="$(cfg PROVER)"
  local elf_sha="" vkey=""
  if [[ "$prover" == on ]]; then
    vkey="$(cfg VKEY_JSON)"
    [[ -n "$vkey" && -f "$(abs "$vkey")" ]] || die ProverVkeyMissing "PROVER=on needs VKEY_JSON in $ENV_FILE to name your verification-key file (got '${vkey:-unset}')"
    elf_sha="$(jq -r '.elf_sha256 // empty' "$(abs "$vkey")" 2>/dev/null | sed 's/^0x//')"
    [[ "$elf_sha" =~ ^[0-9a-fA-F]{64}$ ]] || die ProverVkeyInvalid "$(abs "$vkey") has no 64-hex-character elf_sha256"
  fi

  # A genesis that is already there is never rewritten: a node refuses to start on a genesis that differs from its own
  # chain state, so a changed chain.toml must not slip a new one in. Nothing else is written when this refuses.
  if [[ -e "$OUT/genesis.json" ]] && ! cmp -s "$STAGE/genesis.json" "$OUT/genesis.json"; then
    local old_cid cause="chain.toml would change it"
    old_cid="$(jq -r '.config.chainId // empty' "$OUT/genesis.json" 2>/dev/null)"
    if [[ -n "$old_cid" && "$old_cid" != "$chain_id" ]]; then
      cause="the chain id would change from $old_cid to $chain_id (the payer's registration nonce moved, and $rec, which keeps the first id, is missing)"
    fi
    echo "GenesisDrift: $OUT/genesis.json already exists and $cause; refusing to overwrite a genesis that may be live" >&2
    echo "fields differing: $(rz_genesis_diff_summary "$OUT/genesis.json" "$STAGE/genesis.json")" >&2
    echo "to start a new chain, move $OUT aside and run init again (the old chain's data volumes must go too)" >&2
    exit 1
  fi

  # Compose variables.
  local seq_key opt
  seq_key="$(abs "$(cfg SEQUENCER_KEY_PATH ./keys/sequencer.key)")"
  printf 'AUTHORITY=%s\nNONCE=%s\nCHAIN_ID=%s\n' "$D_AUTHORITY" "$D_NONCE" "$D_ID" > "$STAGE/chain-id.env"
  {
    echo "CHAIN_ID=$chain_id"
    echo "BLOCK_GAS_LIMIT=$gas_limit"
    echo "BLOCKS_PER_BATCH=$blocks_per_batch"
    echo "BATCH_CLOSE_AFTER_SECS=$close_after"
    echo "RENDERED_DIR=$OUT"
    echo "SEQUENCER_KEY_PATH=$seq_key"
    echo "PAYER_KEYPAIR_PATH=$payer_key"
    echo "RPC_BIND=$(cfg RPC_BIND 127.0.0.1)"
    for opt in "${PORT_VARS[@]}"; do echo "$opt=${!opt}"; done
    echo "PROVER_DB_PASSWORD_FILE=$OUT/prover-db-password"
    for opt in ROME_ZK_IMAGE ROME_ZK_TAG ROME_ZK_PROVER_IMAGE VERIFIER_PROOF_WINDOW; do
      v="$(cfg "$opt")"; [[ -z "$v" ]] || echo "$opt=$v"
    done
    for opt in VKEY_JSON ELF_DIR ZISK_HOME PROVER_KEYS_MANIFEST; do
      v="$(cfg "$opt")"; [[ -z "$v" ]] || echo "$opt=$(abs "$v")"
    done
  } > "$STAGE/compose.env"

  mkdir -p "$OUT" || die OutputDirFailed "cannot create $OUT"
  if [[ "$prover" == on ]]; then
    local pw="$OUT/prover-db-password"
    [[ -s "$pw" ]] || (umask 077; openssl rand -hex 24 > "$pw")
    chmod 600 "$pw"
    rz_render_template "$ROLLUP_DIR/prover.toml.template" "$STAGE/prover.toml" "${common[@]}" "ELF_SHA256=$elf_sha" \
      "DATABASE_URL=postgres://rome:$(cat "$pw")@postgres:5432/prover" || exit 1
  else
    rm -f "$OUT/prover.toml"
  fi
  local f
  for f in sequencer-config.toml genesis.json batcher.toml derive.toml compose.env chain-id.env prover.toml; do
    [[ -f "$STAGE/$f" ]] && cp "$STAGE/$f" "$OUT/$f"
  done
  # 0644 on purpose: derive and the verifier node run as other users than you, and the engine port is never published.
  rz_ensure_jwt "$OUT/jwt.hex" 644

  if grep -rqE '__[A-Z0-9_]+__' "$OUT" --include='*.toml' --include='*.json' --include='*.env'; then
    die PlaceholderLeft "a template placeholder is still in $OUT: $(grep -rnE '__[A-Z0-9_]+__' "$OUT" | head -2)"
  fi
  [[ -e "$seq_key" ]] || echo "note: the sequencer key $seq_key does not exist yet (64 hex characters in a file, readable by uid 999)" >&2
  echo "rendered under $OUT: authority=$D_AUTHORITY nonce=$D_NONCE chain_id=$chain_id, genesis gas limit $gas_limit, blocks_per_batch=$blocks_per_batch, cluster=$CLUSTER"
  if [[ -n "$backed" ]]; then
    echo "backed genesis balance: $backed starts with $backed_lamports lamports (${backed_lamports}000000000 wei); every other balance is zero."
    echo "Before you ask Rome to register your verification key, lock exactly $backed_lamports lamports in your chain's vault with zk-bridge Fund. Rome checks that the vault holds it before it registers the key."
    echo "On devnet the vault program is the shared zk-bridge in programs.devnet.json: create your chain's vault for the wrapped SOL mint (9 decimals) with init-vault, then lock the amount with fund."
  fi
}

# ------------------------------------------------------------------------------------------------------ register
account_exists() { # $1=pubkey -> 0 when the account exists, 1 when the RPC says there is none, 2 when it could not be read
  local body json
  body="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getAccountInfo\",\"params\":[\"$1\",{\"encoding\":\"base64\",\"commitment\":\"confirmed\"}]}"
  json="$(curl -sS --max-time 10 -X POST -H 'content-type: application/json' --data "$body" "$SOLANA_RPC_URL" 2>/dev/null)" || return 2
  jq -e '(.result | type == "object") and (.result | has("value"))' <<<"$json" >/dev/null 2>&1 || return 2
  jq -e '.result.value == null' <<<"$json" >/dev/null 2>&1 && return 1
  return 0
}
cmd_register() {
  local dry=0 confirm=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry=1 ;;
      --confirm) confirm=1 ;;
      *) die UnknownArgument "'$1' (usage: rollup register --dry-run | --confirm)" ;;
    esac
    shift
  done
  [[ $dry -eq 1 || $confirm -eq 1 ]] || die refusing "pass --dry-run to see what registration would do, or --confirm to register for real (there is no default)"
  [[ $dry -eq 0 || $confirm -eq 0 ]] || die refusing "--dry-run and --confirm are mutually exclusive"
  require_init
  load_env; load_programs

  local chain_id payer evm_rpc="$SEQUENCER_RPC" max_drift=60 rec="$OUT/chain-id.env" init_id init_nonce init_auth
  chain_id="$(jq -r '.config.chainId' "$OUT/genesis.json")"
  payer="$(abs "$(cfg PAYER_KEYPAIR_PATH ./keys/payer.json)")"
  [[ -f "$rec" ]] || die NotInitialised "$rec does not exist (run ./rollup init first; it records the chain id it read from Solana)"
  init_id="$(rz_env_get "$rec" CHAIN_ID)"; init_nonce="$(rz_env_get "$rec" NONCE)"; init_auth="$(rz_env_get "$rec" AUTHORITY)"
  [[ "$init_id" == "$chain_id" ]] || die ChainIdMismatch "the genesis under $OUT has chain id $chain_id but init recorded $init_id in $rec"
  # Registration sends no verifier keys: the program refuses them on a permissionless chain. Rome registers the
  # chain's layout-1 key afterwards.
  local ops_prefix="docker run --rm --network host --mount type=bind,source=$payer,target=/keys/payer,readonly --entrypoint rome-zk-ops <node image> --rpc-url $SOLANA_RPC_URL"
  local id_cmd reg_cmd cursor_cmd pda_cmd
  id_cmd="$ops_prefix chain-id --settlement $SETTLEMENT_ID --keypair /keys/payer"
  reg_cmd="$ops_prefix register --keypair /keys/payer --settlement $SETTLEMENT_ID --inbox $INBOX_ID --evm-rpc $evm_rpc --permissionless --nonce $init_nonce --expect-chain-id $init_id --max-drift-secs $max_drift --confirm"
  cursor_cmd="$ops_prefix init-cursor --keypair /keys/payer --inbox $INBOX_ID --settlement $SETTLEMENT_ID --chain-id $chain_id --next-batch 1 --confirm"
  pda_cmd="$ops_prefix pdas --inbox $INBOX_ID --settlement $SETTLEMENT_ID --chain-id $chain_id"

  echo "chain_id=$chain_id authority=$init_auth nonce=$init_nonce inbox=$INBOX_ID settlement=$SETTLEMENT_ID cluster=$CLUSTER (init derived this chain id from the authority's nonce and rendered the genesis with it)"
  if [[ $dry -eq 1 ]]; then
    echo "-- dry run: no key read, no network call, nothing started --"
    echo "would run, in order (<node image> is the image ROME_ZK_IMAGE or ROME_ZK_TAG names; no Rust or cargo on this machine):"
    echo "  $id_cmd    # must still print chain_id=$chain_id, or registration stops with NonceAdvanced"
    echo "  $reg_cmd    # skipped when the chain's root account already exists (a re-run after a partial failure)"
    echo "  $cursor_cmd"
    echo "  $pda_cmd    # the printed addresses go to $OUT/pdas.env"
    echo "registration locks the chain deposit from the payer, sends no verifier keys, and starts the sequencer if it is not running (it reads the genesis block from $evm_rpc), so it needs only the Solana RPC otherwise"
    return 0
  fi

  need_image
  # The payer must be the authority init recorded, on a first registration and on a resume alike. Say so by name before
  # any nonce is compared, so a changed key is not reported as a moved nonce.
  fetch_chain_id "$payer"
  [[ "$D_AUTHORITY" == "$init_auth" ]] || die AuthorityChanged "the payer key $payer is $D_AUTHORITY, but $rec records the chain's authority as $init_auth; use that key again (PAYER_KEYPAIR_PATH in $ENV_FILE), or move $OUT aside to start a new chain"
  # The first registration of this chain: check the nonce, bring the sequencer up, send the registration. (Uses this
  # function's variables.)
  register_new_chain() {
    # The id was derived at init from the payer's nonce at that moment. If the nonce moved without this chain being
    # registered, the program would derive another id and the genesis would not match it: refuse here, before anything is
    # sent or locked.
    fetch_chain_id "$payer"
    if [[ "$D_ID" != "$init_id" ]]; then
      # The nonce moves in the same instruction that writes the root. If the root is there now, an earlier run registered
      # this chain and the nonce moved because of it: carry on instead of telling the operator to start over.
      local again_rc=0
      account_exists "$root_pda" || again_rc=$?
      if [[ "$again_rc" -eq 0 ]]; then
        echo "chain $chain_id is already registered (its root account $root_pda exists); not registering again, continuing with the batch cursor"
        return 0
      fi
      # 2 = the RPC failed on this read: whether the chain is registered is not known, so do not advise starting over.
      [[ "$again_rc" -ne 2 ]] || die RootLookupFailed "the nonce moved and the root account could not be read, so it is not known whether chain $chain_id is registered; nothing was sent; run register again"
      die NonceAdvanced "the registration nonce for $D_AUTHORITY is now $D_NONCE (init read $init_nonce), so the next chain id would be $D_ID, not $init_id; nothing was sent. Move $OUT aside, remove the old data volumes and run ./rollup init again"
    fi
    # Registration reads the genesis block from the sequencer, which does not need Solana to run: start it if it is not up.
    local live waited=0 wait_max="${REGISTER_SEQUENCER_WAIT_SECS:-180}"
    sequencer_chain_id() { curl -sS --max-time 5 -X POST -H 'content-type: application/json' --data '{"jsonrpc":"2.0","id":1,"method":"eth_chainId","params":[]}' "$evm_rpc" 2>/dev/null | jq -r '.result // empty' 2>/dev/null; }
    live="$(sequencer_chain_id)"
    if [[ -z "$live" ]]; then
      echo "nothing answers at $evm_rpc; starting the sequencer (./rollup up sequencer) and waiting up to ${wait_max}s for it" >&2
      (cmd_up sequencer) || exit 1
      while [[ -z "$live" && $waited -lt $wait_max ]]; do sleep 1; waited=$((waited+1)); live="$(sequencer_chain_id)"; done
    fi
    [[ -n "$live" ]] || die SequencerNotReachable "nothing answered at $evm_rpc within ${wait_max}s after starting the sequencer; see: ./rollup check"
    [[ "$((live))" == "$chain_id" ]] || die ChainIdMismatch "the sequencer at $evm_rpc reports chain id $((live)), the genesis says $chain_id"

    local out registered
    # The recorded nonce and chain id go with the send, so the program itself refuses a pair that went stale.
    ops_reset; mount_key payer "$payer"
    out="$(ops register --keypair "$REPLY" --settlement "$SETTLEMENT_ID" --inbox "$INBOX_ID" --evm-rpc "$evm_rpc" --permissionless --nonce "$init_nonce" --expect-chain-id "$init_id" --max-drift-secs "$max_drift" --confirm 2>&1)" || { echo "$out" >&2; die RegisterFailed "rome-zk-ops register exited non-zero"; }
    echo "$out"
    registered="$(grep -oE '^chain [0-9]+' <<<"$out" | head -1 | cut -d' ' -f2)"
    if [[ -n "$registered" && "$registered" != "$chain_id" ]]; then
      die NonceAdvanced "the program registered chain id $registered, but the genesis was rendered with $chain_id: the payer's nonce moved while registering (another registration by the same key); init again in a fresh output directory"
    fi
  }

  # The addresses of this chain's accounts are known before anything is sent. If the root account is already there, an
  # earlier run registered this chain and stopped later: carry on from the cursor instead of registering again.
  local pdas cursor_pda root_pda
  ops_reset
  pdas="$(ops pdas --inbox "$INBOX_ID" --settlement "$SETTLEMENT_ID" --chain-id "$chain_id" 2>/dev/null)"
  cursor_pda="$(sed -n 's/^cursor=//p' <<<"$pdas" | head -1)"
  root_pda="$(sed -n 's/^root=//p' <<<"$pdas" | head -1)"
  [[ -n "$cursor_pda" && -n "$root_pda" ]] || die PdaLookupFailed "could not read the batch cursor and root addresses from rome-zk-ops pdas"
  local exists_rc=0
  account_exists "$root_pda" || exists_rc=$?
  case "$exists_rc" in
    0) echo "chain $chain_id is already registered (its root account $root_pda exists); not registering again, continuing with the batch cursor" ;;
    1) register_new_chain ;;
    *) die RootLookupFailed "could not read the root account $root_pda from $SOLANA_RPC_URL, so it is not known whether chain $chain_id is registered; nothing was sent" ;;
  esac
  ops_reset; mount_key payer "$payer"
  ops init-cursor --keypair "$REPLY" --inbox "$INBOX_ID" --settlement "$SETTLEMENT_ID" --chain-id "$chain_id" --next-batch 1 --confirm || die InitCursorFailed "rome-zk-ops init-cursor exited non-zero"
  printf 'CURSOR_PDA=%s\nROOT_PDA=%s\n' "$cursor_pda" "$root_pda" > "$OUT/pdas.env"
  echo "registered; wrote $OUT/pdas.env (cursor $cursor_pda, root $root_pda)"
}

# ----------------------------------------------------------------------------------------------------------- up
dc() {
  local profile=()
  [[ "$(cfg PROVER)" == on ]] && profile=(--profile prover)
  docker compose --env-file "$OUT/compose.env" -f "$ROLLUP_DIR/docker-compose.yml" ${profile[@]+"${profile[@]}"} "$@"
}

cmd_up() {
  require_init
  local seq_key payer_key
  seq_key="$(rz_env_get "$OUT/compose.env" SEQUENCER_KEY_PATH)"
  payer_key="$(rz_env_get "$OUT/compose.env" PAYER_KEYPAIR_PATH)"
  if [[ -z "$(rz_env_get "$OUT/compose.env" ROME_ZK_IMAGE)" && -z "$(rz_env_get "$OUT/compose.env" ROME_ZK_TAG)" ]]; then
    die ImageTagNotSet "set ROME_ZK_TAG in $ENV_FILE to the tag of the source you checked out (published tags: https://github.com/rome-protocol/rome-zk-evm/tags), or ROME_ZK_IMAGE to an image you built, then run ./rollup init again"
  fi
  [[ -f "$seq_key" ]] || die SequencerKeyMissing "$seq_key does not exist (64 hex characters, readable by uid 999)"
  if [[ $# -eq 0 ]] || printf '%s\n' "$@" | grep -qxE 'batcher|prover'; then
    [[ -f "$payer_key" ]] || die PayerKeyMissing "$payer_key does not exist (a funded Solana keypair, readable by uid 999)"
  fi
  dc up -d "$@"
}

# ------------------------------------------------------------------------------------------------------ guest-build
# The guest embeds your genesis, so every chain has its own ELF. The build runs in the guest-build image
# (deploy/rollup/guest-build), which holds ZisK 1.2.0-alpha and clones the public sources of the node tag and the guest
# tag; the image is built here the first time. The output is rendered/guest/<elf sha256>.elf and rendered/guest/vkey.json:
# point ELF_DIR at the directory and VKEY_JSON at the file. The programVK needs the ZisK proving keys (ZISK_HOME) and about
# 36 GB of memory; without them vkey.json is written without it and the command says so.
GUEST_BUILD_EVM_TAG_DEFAULT=v0.2.1
GUEST_BUILD_GUEST_TAG_DEFAULT=v0.2.0
cmd_guest_build() {
  local skip_vk=0 a
  for a in "$@"; do
    case "$a" in
      --skip-program-vk) skip_vk=1 ;;
      *) die UnknownArgument "'$a' (usage: rollup guest-build [--skip-program-vk])" ;;
    esac
  done
  require_init
  [[ -f "$OUT/chain-id.env" ]] || die NotInitialised "$OUT/chain-id.env does not exist (run ./rollup init first)"
  command -v docker >/dev/null 2>&1 || die DockerMissing "docker is not installed (the guest is built in an image)"
  local chain_id genesis_id funded
  chain_id="$(rz_env_get "$OUT/chain-id.env" CHAIN_ID)"
  [[ "$chain_id" =~ ^[0-9]+$ ]] || die ChainIdMissing "$OUT/chain-id.env has no CHAIN_ID (run ./rollup init again)"
  genesis_id="$(python3 -c 'import json,sys
v=json.load(open(sys.argv[1]))["config"]["chainId"]
assert isinstance(v,int) and not isinstance(v,bool) and v>0
print(v)' "$OUT/genesis.json" 2>/dev/null)" || die GenesisInvalid "$OUT/genesis.json is not a genesis file with a numeric config.chainId"
  [[ "$genesis_id" == "$chain_id" ]] || die ChainIdMismatch "$OUT/genesis.json has config.chainId $genesis_id but your chain's id is $chain_id (from $OUT/chain-id.env). A guest built from this genesis could never prove your chain. Run ./rollup init again."
  funded="$(python3 -c 'import json,sys
a=json.load(open(sys.argv[1])).get("alloc") or {}
def n(v):
    v=v.get("balance","0") if isinstance(v,dict) else "0"
    return int(v,16) if isinstance(v,str) and v.lower().startswith("0x") else int(v)
print(sum(1 for v in a.values() if n(v)>0))' "$OUT/genesis.json" 2>/dev/null)" || die GenesisInvalid "$OUT/genesis.json has an alloc the guest build cannot read"
  [[ "$funded" -le 1 ]] || die GenesisFundedAccountLimit "$OUT/genesis.json gives $funded accounts a non-zero balance; at most one is allowed (the one balance must be locked in your chain's vault)"
  [[ "$OUT" != *,* ]] || die OutputDirInvalid "$OUT has a comma in it, which a bind mount cannot take"

  local zisk_home keys=() keyargs=()
  zisk_home="$(cfg ZISK_HOME)"
  if (( skip_vk )); then
    echo "guest-build: --skip-program-vk: vkey.json will have no programVK" >&2
  elif [[ -z "$zisk_home" ]]; then
    echo "guest-build: ZISK_HOME is not set in $ENV_FILE, so the programVK is not computed and vkey.json will have none (set it to the directory holding the ZisK proving keys to get it)" >&2
  elif [[ ! -d "$(abs "$zisk_home")/provingKey" ]]; then
    die ProvingKeyDirMissing "$(abs "$zisk_home")/provingKey does not exist (ZISK_HOME in $ENV_FILE must hold the ZisK 1.2.0-alpha proving keys; or pass --skip-program-vk)"
  else
    zisk_home="$(abs "$zisk_home")"
    [[ "$zisk_home" != *,* ]] || die KeyPathInvalid "$zisk_home has a comma in it, which a bind mount cannot take"
    keys=(--mount "type=bind,source=$zisk_home/provingKey,target=/keys/provingKey,readonly")
    keyargs=(--proving-key-dir /keys/provingKey)
  fi

  local evm_tag guest_tag image
  evm_tag="$(cfg ROME_ZK_TAG "$GUEST_BUILD_EVM_TAG_DEFAULT")"
  guest_tag="$(cfg ROME_ZK_GUEST_TAG "$GUEST_BUILD_GUEST_TAG_DEFAULT")"
  image="rome-zk-guest-build:$evm_tag-$guest_tag"
  echo "guest-build: building the image $image (ZisK 1.2.0-alpha, rome-zk-evm $evm_tag, rome-zk-guest $guest_tag); the first build takes several minutes" >&2
  docker build --platform linux/amd64 -t "$image" \
    --build-arg "ROME_ZK_EVM_TAG=$evm_tag" --build-arg "ROME_ZK_GUEST_TAG=$guest_tag" \
    "$ROLLUP_DIR/guest-build" >&2 || die GuestBuildImageFailed "docker build of $image failed"

  mkdir -p "$OUT/guest" || die OutputDirFailed "cannot create $OUT/guest"
  local started result rc
  started="$(date +%s)"
  result="$(docker run --rm --platform linux/amd64 \
    --mount "type=bind,source=$OUT/genesis.json,target=/in/genesis.json,readonly" \
    --mount "type=bind,source=$OUT/guest,target=/out" \
    ${keys[@]+"${keys[@]}"} -e "OUT_UID=$(id -u)" -e "OUT_GID=$(id -g)" \
    "$image" --expect-chain-id "$chain_id" ${keyargs[@]+"${keyargs[@]}"})"; rc=$?
  [[ $rc -eq 0 ]] || die GuestBuildFailed "the build in $image stopped with exit $rc (the reason is above)"
  local sha pvk
  sha="$(sed -n 's/^elf_sha256=//p' <<<"$result" | head -n 1)"
  pvk="$(sed -n 's/^program_vk=//p' <<<"$result" | head -n 1)"
  [[ "$sha" =~ ^[0-9a-f]{64}$ && -f "$OUT/guest/$sha.elf" && -f "$OUT/guest/vkey.json" ]] || die GuestBuildFailed "the build reported no ELF under $OUT/guest"
  [[ "$(python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$OUT/guest/$sha.elf")" == "$sha" ]] || die GuestBuildFailed "$OUT/guest/$sha.elf does not hash to $sha"
  echo "guest ELF       $OUT/guest/$sha.elf"
  echo "elf sha256      $sha"
  echo "chain id        $chain_id"
  echo "program VK      ${pvk:-none}"
  echo "vkey.json       $OUT/guest/vkey.json"
  echo "took            $(( $(date +%s) - started )) s"
  echo "Set ELF_DIR=$OUT/guest and VKEY_JSON=$OUT/guest/vkey.json in $ENV_FILE for the prover."
  if [[ -z "$pvk" || "$pvk" == none ]]; then
    echo "ProgramVkNotComputed: vkey.json has no programVK (the reason is above), and the prover refuses a vkey.json without one. Run this command on a machine with the ZisK proving keys (ZISK_HOME) and at least 40 GiB of memory, or get the programVK for this ELF from Rome and add it to vkey.json as \"programVK\"." >&2
  fi
  return 0
}

# --------------------------------------------------------------------------------------------- operator commands
# One context for every command below: the rendered chain, the Solana RPC, the programs file and the payer key. Sets
# CHAIN_ID and PAYER (the host path of the key). Each command then says which keys it mounts.
ops_context() {
  require_init
  load_env; load_programs
  CHAIN_ID="$(jq -r '.config.chainId // empty' "$OUT/genesis.json" 2>/dev/null)"
  [[ "$CHAIN_ID" =~ ^[0-9]+$ ]] || die NotInitialised "$OUT/genesis.json has no chain id (run ./rollup init again)"
  PAYER="$(rz_env_get "$OUT/compose.env" PAYER_KEYPAIR_PATH)"
  [[ -n "$PAYER" ]] || PAYER="$(abs "$(cfg PAYER_KEYPAIR_PATH ./keys/payer.json)")"
  need_image
  ops_reset
}
need_bridge() {
  [[ -n "$BRIDGE_ID" ]] || die ProgramsFileInvalid "$PROGRAMS has no value for programs.zk-bridge, which the vault and exit commands need"
}
# MODE holds the one flag that says whether a command sends: nothing (a dry run), --confirm, or --offline. REST holds the
# arguments that are left. --confirm with --dry-run or --offline is refused by name.
parse_mode() {
  MODE=(); REST=()
  local confirm=0 dry=0 offline=0 a
  for a in "$@"; do
    case "$a" in
      --confirm) confirm=1 ;;
      --dry-run) dry=1 ;;
      --offline) offline=1 ;;
      *) REST+=("$a") ;;
    esac
  done
  (( confirm == 0 || (dry == 0 && offline == 0) )) || die ConfirmAndDryRun "--confirm cannot go with --dry-run or --offline: a command either sends or it does not"
  (( confirm )) && MODE=(--confirm)
  (( offline )) && MODE=(--offline)
  return 0
}
# flag_value FLAG VALUE-OR-EMPTY -> the value, refused by name when it is missing
flag_value() { [[ -n "${2:-}" ]] || die FlagValueMissing "$1 needs a value"; printf '%s' "$2"; }
only_numbers() { [[ "$2" =~ ^[0-9]+$ ]] || die FlagValueInvalid "$1 must be a whole number (got '$2')"; }
hex_bytes() { # NAME VALUE BYTES
  local want=$(( $3 * 2 ))
  [[ "${2#0x}" =~ ^[0-9a-fA-F]+$ && ${#2} -ge $want && "${2#0x}" =~ ^[0-9a-fA-F]{$want}$ ]] || die FlagValueInvalid "$1 must be $3 bytes of hex ($(( $3 * 2 )) characters, with or without 0x)"
}

cmd_refund_deposit() {
  parse_mode "$@"
  [[ ${#REST[@]} -eq 0 ]] || die UnknownArgument "'${REST[0]}' (usage: rollup refund-deposit [--confirm])"
  ops_context
  mount_key payer "$PAYER"
  ops refund-deposit --settlement "$SETTLEMENT_ID" --chain-id "$CHAIN_ID" --keypair "$REPLY" ${MODE[@]+"${MODE[@]}"}
}

cmd_exit_config() {
  local sub="${1:-}"; [[ $# -eq 0 ]] || shift
  case "$sub" in
    propose)
      parse_mode "$@"; set -- "${REST[@]+"${REST[@]}"}"
      local flags=() have_field=0 slot="" delay="" v
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --exit-portal) v="$(flag_value "$1" "${2:-}")" || exit 1; hex_bytes "$1" "$v" 20; flags+=(--exit-portal "$v"); have_field=1; shift 2 ;;
          --bridge-program) v="$(flag_value "$1" "${2:-}")" || exit 1; flags+=(--bridge-program "$v"); have_field=1; shift 2 ;;
          --exit-cap) v="$(flag_value "$1" "${2:-}")" || exit 1; only_numbers "$1" "$v"; flags+=(--exit-cap "$v"); have_field=1; shift 2 ;;
          --poster-bond) v="$(flag_value "$1" "${2:-}")" || exit 1; only_numbers "$1" "$v"; flags+=(--poster-bond "$v"); have_field=1; shift 2 ;;
          --activation-slot) slot="$(flag_value "$1" "${2:-}")" || exit 1; only_numbers "$1" "$slot"; shift 2 ;;
          --activation-delay-slots) delay="$(flag_value "$1" "${2:-}")" || exit 1; only_numbers "$1" "$delay"; shift 2 ;;
          *) die UnknownArgument "'$1' (usage: rollup exit-config propose [--exit-portal 0x..] [--bridge-program P] [--exit-cap N] [--poster-bond N] --activation-slot N | --activation-delay-slots N [--confirm])" ;;
        esac
      done
      (( have_field )) || die NothingProposed "name at least one of --exit-portal, --bridge-program, --exit-cap, --poster-bond"
      [[ -n "$slot" || -n "$delay" ]] || die ActivationMissing "give --activation-slot N or --activation-delay-slots N: a proposal takes effect only at a slot you choose"
      [[ -z "$slot" || -z "$delay" ]] || die ActivationConflict "give --activation-slot or --activation-delay-slots, not both"
      [[ -z "$slot" ]] || flags+=(--activation-slot "$slot")
      [[ -z "$delay" ]] || flags+=(--activation-delay-slots "$delay")
      ops_context
      mount_key payer "$PAYER"
      # The chain authority is the payer key: the registration made it the authority.
      ops exit-config propose --settlement "$SETTLEMENT_ID" --chain-id "$CHAIN_ID" --chain-authority-keypair "$REPLY" --payer-keypair "$REPLY" "${flags[@]}" ${MODE[@]+"${MODE[@]}"} ;;
    activate)
      parse_mode "$@"
      [[ ${#REST[@]} -eq 0 ]] || die UnknownArgument "'${REST[0]}' (usage: rollup exit-config activate [--confirm])"
      ops_context
      mount_key payer "$PAYER"
      ops exit-config activate --settlement "$SETTLEMENT_ID" --chain-id "$CHAIN_ID" --payer-keypair "$REPLY" ${MODE[@]+"${MODE[@]}"} ;;
    show)
      [[ $# -eq 0 ]] || die UnknownArgument "'$1' (usage: rollup exit-config show)"
      ops_context
      ops exit-config show --settlement "$SETTLEMENT_ID" --chain-id "$CHAIN_ID" ;;
    *) die UnknownSubcommand "'$sub' (usage: rollup exit-config propose|activate|show)" ;;
  esac
}

WRAPPED_SOL_MINT=So11111111111111111111111111111111111111112
cmd_vault() {
  local sub="${1:-}"; [[ $# -eq 0 ]] || shift
  case "$sub" in
    init)
      parse_mode "$@"; set -- "${REST[@]+"${REST[@]}"}"
      local mint="$WRAPPED_SOL_MINT" decimals=9
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --mint) mint="$(flag_value "$1" "${2:-}")" || exit 1; shift 2 ;;
          --mint-decimals) decimals="$(flag_value "$1" "${2:-}")" || exit 1; only_numbers "$1" "$decimals"; shift 2 ;;
          *) die UnknownArgument "'$1' (usage: rollup vault init [--mint M] [--mint-decimals N] [--confirm]; the default is wrapped SOL, 9 decimals)" ;;
        esac
      done
      ops_context; need_bridge
      mount_key payer "$PAYER"
      ops vault init --authority-keypair "$REPLY" --mint "$mint" --mint-decimals "$decimals" --settlement "$SETTLEMENT_ID" --bridge "$BRIDGE_ID" --chain-id "$CHAIN_ID" ${MODE[@]+"${MODE[@]}"} ;;
    fund)
      parse_mode "$@"; set -- "${REST[@]+"${REST[@]}"}"
      local amount=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --amount) amount="$(flag_value "$1" "${2:-}")" || exit 1; only_numbers "$1" "$amount"; shift 2 ;;
          *) die UnknownArgument "'$1' (usage: rollup vault fund --amount RAW_TOKEN_UNITS [--confirm])" ;;
        esac
      done
      [[ -n "$amount" ]] || die AmountMissing "give --amount N, in the mint's raw token units (lamports for wrapped SOL)"
      ops_context; need_bridge
      mount_key payer "$PAYER"
      ops vault fund --payer-keypair "$REPLY" --amount "$amount" --settlement "$SETTLEMENT_ID" --bridge "$BRIDGE_ID" --chain-id "$CHAIN_ID" ${MODE[@]+"${MODE[@]}"} ;;
    show)
      [[ $# -eq 0 ]] || die UnknownArgument "'$1' (usage: rollup vault show)"
      ops_context; need_bridge
      ops vault show --settlement "$SETTLEMENT_ID" --bridge "$BRIDGE_ID" --chain-id "$CHAIN_ID" ;;
    *) die UnknownSubcommand "'$sub' (usage: rollup vault init|fund|show)" ;;
  esac
}

cmd_release_exit() {
  parse_mode "$@"; set -- "${REST[@]+"${REST[@]}"}"
  local hash=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --message-hash) hash="$(flag_value "$1" "${2:-}")" || exit 1; shift 2 ;;
      *) die UnknownArgument "'$1' (usage: rollup release-exit --message-hash 0x... [--confirm])" ;;
    esac
  done
  [[ -n "$hash" ]] || die MessageHashMissing "give --message-hash 0x followed by 64 hex characters: the exit's message hash"
  hex_bytes --message-hash "$hash" 32
  ops_context; need_bridge
  mount_key payer "$PAYER"
  ops release-exit --settlement "$SETTLEMENT_ID" --bridge "$BRIDGE_ID" --chain-id "$CHAIN_ID" --message-hash "$hash" --payer-keypair "$REPLY" ${MODE[@]+"${MODE[@]}"}
}

cmd_migrate() {
  parse_mode "$@"; set -- "${REST[@]+"${REST[@]}"}"
  local registry="" drift="" v
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --registry-keypair) v="$(flag_value "$1" "${2:-}")" || exit 1; registry="$(abs "$v")"; shift 2 ;;
      --max-drift-secs) drift="$(flag_value "$1" "${2:-}")" || exit 1; only_numbers "$1" "$drift"; shift 2 ;;
      *) die UnknownArgument "'$1' (usage: rollup migrate --registry-keypair FILE --max-drift-secs N [--confirm])" ;;
    esac
  done
  [[ -n "$registry" ]] || die RegistryKeypairMissing "give --registry-keypair FILE: only the registry authority can migrate a chain"
  [[ -n "$drift" ]] || die MaxDriftMissing "give --max-drift-secs N: the chain's timestamp drift bound has no default"
  ops_context
  mount_key payer "$PAYER"; local payer_in="$REPLY"
  mount_key registry "$registry"
  ops migrate --settlement "$SETTLEMENT_ID" --chain-id "$CHAIN_ID" --registry-keypair "$REPLY" --payer-keypair "$payer_in" --max-drift-secs "$drift" ${MODE[@]+"${MODE[@]}"}
}

# The services compose knows, for `logs`.
KNOWN_SERVICES=(sequencer batcher reth-verifier derive prover postgres)
cmd_logs() {
  local follow=() tail="${LOGS_TAIL:-200}" svcs=() s k
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=(--follow); shift ;;
      --tail) tail="$(flag_value "$1" "${2:-}")" || exit 1; only_numbers "$1" "$tail"; shift 2 ;;
      -*) die UnknownArgument "'$1' (usage: rollup logs [-f] [--tail N] [service...])" ;;
      *) svcs+=("$1"); shift ;;
    esac
  done
  for s in ${svcs[@]+"${svcs[@]}"}; do
    k=0; for known in "${KNOWN_SERVICES[@]}"; do [[ "$s" == "$known" ]] && k=1; done
    (( k )) || die UnknownService "'$s' is not a service (${KNOWN_SERVICES[*]})"
  done
  require_init
  dc logs --tail "$tail" ${follow[@]+"${follow[@]}"} ${svcs[@]+"${svcs[@]}"}
}

cmd_down() {
  [[ $# -eq 0 ]] || die UnknownArgument "'$1' (usage: rollup down; it stops and removes the containers and keeps the data volumes, so the chain's data is safe; remove a volume yourself only to start a chain over)"
  require_init
  dc down
}

cmd_status() {
  [[ $# -eq 0 ]] || die UnknownArgument "'$1' (usage: rollup status)"
  ops_context
  echo "chain_id=$CHAIN_ID cluster=$CLUSTER settlement=$SETTLEMENT_ID inbox=$INBOX_ID"
  echo "-- services --"
  dc ps || die ComposeFailed "docker compose ps failed"
  echo "-- the chain on Solana ($SOLANA_RPC_URL) --"
  ops chain-status --settlement "$SETTLEMENT_ID" --chain-id "$CHAIN_ID" || die StatusFailed "rome-zk-ops chain-status could not read the chain (the refusal is above)"
}

# -------------------------------------------------------------------------------------------------------- check
FAILED=0
pass() { echo "PASS: $1 — $2"; }
fail() { echo "FAIL: $1 — $2"; FAILED=1; }
skip() { echo "SKIP: $1 — $2"; }
warn() { echo "WARN: $1 — $2"; } # named and visible, but the check still passes

rpc() { # $1=url $2=method -> the result field, or nothing
  curl -sS --max-time 5 -X POST -H 'content-type: application/json' \
    --data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"$2\",\"params\":[]}" "$1" 2>/dev/null | jq -r '.result // empty' 2>/dev/null
}
metric() { # $1=url $2=metric name -> the last sample's value, or nothing
  curl -sS --max-time 5 "$1" 2>/dev/null | grep -E "^$2( |\{)" | tail -1 | awk '{print $NF}'
}
account_u64() { # $1=pubkey $2=byte offset -> decimal, or nothing (and non-zero) when the account is absent or short
  local body json b64
  body="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getAccountInfo\",\"params\":[\"$1\",{\"encoding\":\"base64\",\"commitment\":\"confirmed\"}]}"
  json="$(curl -sS --max-time 10 -X POST -H 'content-type: application/json' --data "$body" "$SOLANA_RPC_URL" 2>/dev/null)" || return 1
  b64="$(jq -r '.result.value.data[0] // empty' <<<"$json" 2>/dev/null)"
  [[ -n "$b64" ]] || return 1
  python3 - "$b64" "$2" <<'PY' 2>/dev/null
import base64, struct, sys
data = base64.b64decode(sys.argv[1]); off = int(sys.argv[2])
if len(data) < off + 8:
    sys.exit(1)
print(struct.unpack_from("<Q", data, off)[0])
PY
}

sol_balance() { # $1=pubkey -> lamports, or nothing (and non-zero) when the RPC does not answer
  local body json v
  body="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getBalance\",\"params\":[\"$1\",{\"commitment\":\"confirmed\"}]}"
  json="$(curl -sS --max-time 10 -X POST -H 'content-type: application/json' --data "$body" "$SOLANA_RPC_URL" 2>/dev/null)" || return 1
  v="$(jq -r '.result.value // empty' <<<"$json" 2>/dev/null)"
  [[ "$v" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$v"
}

cmd_check() {
  require_init
  load_env
  load_programs
  local env="$OUT/compose.env" sample="${CHECK_SAMPLE_SECS:-3}"
  local chain_id bpb close_after prover
  chain_id="$(rz_env_get "$env" CHAIN_ID)"; bpb="$(rz_env_get "$env" BLOCKS_PER_BATCH)"
  close_after="$(rz_env_get "$env" BATCH_CLOSE_AFTER_SECS)"; prover="$(cfg PROVER)"

  # Services. A service that is not running is named once; the items that need it are skipped with the reason.
  local services=(sequencer batcher reth-verifier derive) running svc
  [[ "$prover" == on ]] && services+=(prover postgres)
  running="$(dc ps --services --status running 2>/dev/null)"
  declare -A up_
  for svc in "${services[@]}"; do
    if grep -qx "$svc" <<<"$running"; then up_[$svc]=1; pass "service $svc" "running"
    else up_[$svc]=0; fail "service $svc" "ServiceMissing: $svc is not running (start it with ./rollup up)"; fi
  done
  needs() { # needs svc... -> 0 when all are running; otherwise sets MISSING to the first that is not
    local s; for s in "$@"; do [[ "${up_[$s]:-0}" == 1 ]] || { MISSING="$s"; return 1; }; done; return 0
  }

  # Chain id and sequencer head (blocks advance, or the sequencer's own idle counter does).
  local bn1="" bn2="" idle1="" idle2="" ver1="" ver2="" head_ok=0
  if needs sequencer; then
    local cid
    cid="$(rpc "$SEQUENCER_RPC" eth_chainId)"
    if [[ -z "$cid" ]]; then fail "chain id" "SequencerUnreachable: no answer from $SEQUENCER_RPC"
    elif [[ "$((cid))" == "$chain_id" ]]; then pass "chain id" "$((cid)) matches chain.toml"
    else fail "chain id" "ChainIdMismatch: the sequencer reports $((cid)), chain.toml says $chain_id"; fi

    bn1="$(rpc "$SEQUENCER_RPC" eth_blockNumber)"; idle1="$(metric "$METRICS_SEQUENCER" rome_zk_sequencer_idle_ticks_total)"
    needs reth-verifier && ver1="$(rpc "$VERIFIER_RPC" eth_blockNumber)"
    sleep "$sample"
    bn2="$(rpc "$SEQUENCER_RPC" eth_blockNumber)"; idle2="$(metric "$METRICS_SEQUENCER" rome_zk_sequencer_idle_ticks_total)"
    needs reth-verifier && ver2="$(rpc "$VERIFIER_RPC" eth_blockNumber)"
    if [[ -z "$bn1" || -z "$bn2" ]]; then
      fail "sequencer head" "SequencerUnreachable: eth_blockNumber gave no answer"
    elif (( bn2 > bn1 )); then pass "sequencer head" "advancing, block $((bn1)) to $((bn2)) in ${sample}s"; head_ok=1
    elif [[ -n "$idle1" && -n "$idle2" ]] && awk -v a="$idle1" -v b="$idle2" 'BEGIN{exit !(b>a)}'; then
      pass "sequencer head" "idle at block $((bn2)): no transactions, but its idle counter rose ($idle1 to $idle2)"; head_ok=1
    else fail "sequencer head" "SequencerStalled: block stayed at $((bn2)) for ${sample}s and the idle counter did not rise (${idle1:-no metric} to ${idle2:-no metric})"; fi
  else
    skip "chain id" "needs the sequencer, which is not running"
    skip "sequencer head" "needs the sequencer, which is not running"
  fi

  # Solana side: the batch cursor and the root account, found through pdas.env (written by `rollup register`).
  local next_batch="" head_final="" cursor_pda root_pda have_pdas=0 cursor_ok=0 root_ok=0
  if [[ -f "$OUT/pdas.env" ]]; then
    have_pdas=1; cursor_pda="$(rz_env_get "$OUT/pdas.env" CURSOR_PDA)"; root_pda="$(rz_env_get "$OUT/pdas.env" ROOT_PDA)"
  fi
  if (( have_pdas )); then
    if next_batch="$(account_u64 "$cursor_pda" 13)" && [[ -n "$next_batch" ]]; then
      cursor_ok=1; pass "batcher cursor" "next_batch=$next_batch (account $cursor_pda)"
    else fail "batcher cursor" "CursorUnreadable: could not read the batch cursor account $cursor_pda from $SOLANA_RPC_URL (is the chain registered on this cluster?)"; fi
  else
    fail "batcher cursor" "PdasMissing: $OUT/pdas.env does not exist; run ./rollup register --confirm, which writes it"
  fi

  # Batches finalized against blocks sealed. The batcher's own age gauge resets on every age close and stands still while
  # the batcher waits on Solana, so it cannot see a stuck batcher. Two counters can: blocks the sequencer sealed and
  # batches the batcher finalized. Each run of this check records both; once a sample from at least the window ago exists,
  # blocks sealed since then with no batch finalized is a stuck batcher, the same rule the example alerts use. A restart
  # of either process resets its counter, and a sample from before a reset is not used.
  local window="${CHECK_FINALIZE_WINDOW_SECS:-$(( close_after * 4 > 900 ? close_after * 4 : 900 ))}"
  if needs sequencer batcher; then
    local sealed finalized now samples="$OUT/check-samples" base
    sealed="$(metric "$METRICS_SEQUENCER" rome_zk_sequencer_blocks_sealed_total)"
    finalized="$(metric "$METRICS_BATCHER" rome_zk_batcher_batches_finalized_total)"
    if [[ ! "$sealed" =~ ^[0-9]+(\.[0-9]+)?$ || ! "$finalized" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
      fail "batches finalized" "BatcherUnreachable: no blocks-sealed or batches-finalized counter from $METRICS_SEQUENCER and $METRICS_BATCHER"
    else
      sealed="${sealed%.*}"; finalized="${finalized%.*}"; now="${CHECK_NOW:-$(date +%s)}"
      base=""
      [[ ! -f "$samples" ]] || base="$(awk -v now="$now" -v w="$window" -v s="$sealed" -v f="$finalized" '
        NF == 3 { n++; t[n] = $1; a[n] = $2; b[n] = $3 }
        END { ls = s; lf = f
          for (i = n; i >= 1; i--) {
            if (a[i] > ls || b[i] > lf) break
            ls = a[i]; lf = b[i]
            if (now - t[i] >= w) { print t[i], a[i], b[i]; break } } }' "$samples" 2>/dev/null)"
      { [[ -f "$samples" ]] && tail -n 499 "$samples"; echo "$now $sealed $finalized"; } > "$samples.new" 2>/dev/null && mv "$samples.new" "$samples" 2>/dev/null
      if [[ -z "$base" ]]; then
        skip "batches finalized" "no sample from at least ${window}s ago yet (sealed $sealed, finalized $finalized); run ./rollup check on a timer and it judges the window from the second run on"
      else
        local bt bs bf; read -r bt bs bf <<<"$base"
        if (( sealed > bs && finalized == bf )); then
          fail "batches finalized" "BatchesNotFinalizing: $((sealed - bs)) blocks sealed in the last $((now - bt))s and the batcher finalized no batch (finalized_total stayed at $finalized)"
        else
          pass "batches finalized" "sealed +$((sealed - bs)) blocks, finalized +$((finalized - bf)) batches in the last $((now - bt))s (window ${window}s)"
        fi
      fi
    fi
  else
    skip "batches finalized" "needs the sequencer and the batcher, which are not both running"
  fi

  # Inbox batches: next_batch - 1 batches are on Solana, and a batch holds at most blocks_per_batch blocks. A sequencer
  # that is two batches' worth of blocks ahead of what the posted batches could hold has an unposted tail, whatever the
  # batcher's own gauges say.
  if (( cursor_ok )) && [[ -n "$bn2" ]]; then
    local posted=$(( next_batch - 1 )) unposted=$(( bn2 - (next_batch - 1) * bpb ))
    if (( unposted >= 2 * bpb )); then
      if (( posted == 0 )); then fail "inbox batches" "NoBatchPosted: nothing is on Solana and the sequencer is at block $((bn2)), $((2 * bpb)) or more blocks ahead"
      else fail "inbox batches" "BatcherBehind: $posted batches posted hold at most $((posted * bpb)) blocks and the sequencer is at block $((bn2)) (at least $unposted unposted, limit $((2 * bpb - 1)))"; fi
    elif (( posted > 0 )); then pass "inbox batches" "$posted posted (next_batch=$next_batch)"
    else pass "inbox batches" "0 posted yet, and the sequencer is at block $((bn2)), under two batches ($((2 * bpb)) blocks)"; fi
  elif (( cursor_ok )); then skip "inbox batches" "needs the sequencer's head, which could not be read"
  else skip "inbox batches" "needs the batch cursor, which could not be read"; fi

  # Roots: the settlement account's last finalized batch.
  if (( have_pdas )); then
    if head_final="$(account_u64 "$root_pda" 186)" && [[ -n "$head_final" ]]; then
      root_ok=1; pass "roots" "head_final_batch=$head_final (account $root_pda)"
    else fail "roots" "RootUnreadable: could not read the root account $root_pda from $SOLANA_RPC_URL"; fi
  else
    skip "roots" "needs pdas.env (run ./rollup register --confirm)"
  fi

  # Settlement lag and prover lag only mean something with a prover.
  if [[ "$prover" == on ]]; then
    if (( cursor_ok && root_ok )); then
      local lag=$(( next_batch - 1 - head_final ))
      if (( lag <= 2 )); then pass "settlement lag" "lag=$lag batches (posted $((next_batch - 1)), finalized $head_final)"
      else fail "settlement lag" "SettlementBehind: lag=$lag batches (posted $((next_batch - 1)), finalized $head_final, bound 2)"; fi
    else skip "settlement lag" "needs the cursor and root accounts, which could not both be read"; fi
    if needs prover; then
      local behind secs
      behind="$(metric "$METRICS_PROVER" rome_zk_prover_batches_behind)"; secs="$(metric "$METRICS_PROVER" rome_zk_prover_lag_seconds)"
      if [[ -n "$behind" ]] && awk -v b="$behind" -v s="${secs:-0}" 'BEGIN{exit !(b<=2 && s<=600)}'; then
        pass "prover lag" "batches_behind=$behind, oldest unproved batch ${secs:-0}s old"
      else fail "prover lag" "ProverBehind: batches_behind=${behind:-no metric}, lag_seconds=${secs:-no metric} (bounds 2 batches, 600s)"; fi
    else skip "prover lag" "needs the prover, which is not running"; fi
  else
    skip "settlement lag" "no prover configured (PROVER=on in .env turns it on)"
    skip "prover lag" "no prover configured (PROVER=on in .env turns it on)"
  fi

  # The payer: it pays every Solana fee and the rent of every batch. Below the floor the batcher stops sending.
  local payer_pk floor="${PAYER_FLOOR_LAMPORTS:-$(cfg PAYER_FLOOR_LAMPORTS 1000000000)}" bal
  payer_pk="$(rz_env_get "$OUT/chain-id.env" AUTHORITY)"
  if [[ -z "$payer_pk" ]]; then skip "payer balance" "needs $OUT/chain-id.env, which ./rollup init writes"
  elif bal="$(sol_balance "$payer_pk")" && [[ "$bal" =~ ^[0-9]+$ ]]; then
    if (( bal >= floor )); then pass "payer balance" "$bal lamports at $payer_pk (floor $floor)"
    else fail "payer balance" "PayerBelowFloor: $bal lamports at $payer_pk, floor $floor (fund it, or move the floor with PAYER_FLOOR_LAMPORTS)"; fi
  else fail "payer balance" "PayerBalanceUnreadable: could not read the balance of $payer_pk from $SOLANA_RPC_URL"; fi

  # What the settlement program says about the chain, read once through rome-zk-ops from the node image.
  local cs="" cs_ok=0 cs_why="" margin="${RECLAIM_MARGIN_SLOTS:-$(cfg RECLAIM_MARGIN_SLOTS 108000)}"
  if OPS_IMAGE="$(node_image)"; then
    ops_reset
    if cs="$(ops chain-status --settlement "$SETTLEMENT_ID" --chain-id "$chain_id" 2>&1)"; then cs_ok=1; else cs_why="$(tail -1 <<<"$cs")"; fi
  else cs_why="ImageTagNotSet: neither ROME_ZK_IMAGE nor ROME_ZK_TAG is set in $env"; fi
  csv() { sed -n "s/^$1=//p" <<<"$cs" | head -1; }
  if [[ "$prover" != on ]]; then
    skip "verification key" "no prover configured (PROVER=on in .env turns it on)"
  elif (( cs_ok )); then
    if [[ "$(csv vkey_active)" == yes ]]; then pass "verification key" "active for the proving layout ($(csv vkey_entries) registry entries)"
    else
      local pend; pend="$(csv vkey_pending_activation_slot)"
      fail "verification key" "VkeyNotActive: no verification key is active for this chain's proving layout${pend:+ (one activates at slot $pend, now at slot $(csv slot))}; the prover cannot settle until Rome registers one"
    fi
  else fail "verification key" "ChainStatusUnreadable: ${cs_why:-rome-zk-ops chain-status failed}"; fi
  if (( cs_ok )); then
    local left; left="$(csv reclaim_slots_left)"
    if [[ "$left" == none ]]; then pass "reclaim deadline" "the chain has posted a root; nobody can reclaim it"
    elif [[ "$left" =~ ^[0-9]+$ ]]; then
      if (( left == 0 )); then fail "reclaim deadline" "ReclaimDeadlinePassed: the window is over and this chain has not posted a root, so anyone can reclaim its registration now; post a root or the chain can be taken from you"
      elif (( left < margin )); then fail "reclaim deadline" "ReclaimDeadlineNear: $left slots left (about $(( left * 4 / 36000 )) hours) until anyone can reclaim this chain, which has not posted a root; post a root before then (the margin is $margin slots)"
      else pass "reclaim deadline" "$left slots left (about $(( left * 4 / 36000 )) hours), margin $margin"; fi
    else fail "reclaim deadline" "ChainStatusUnreadable: no reclaim_slots_left line in the chain-status output"; fi
  else fail "reclaim deadline" "ChainStatusUnreadable: ${cs_why:-rome-zk-ops chain-status failed}"; fi

  # The exit configuration the chain runs with, shown.
  local ec="" ec_ok=0 ec_why="$cs_why"
  if OPS_IMAGE="$(node_image)"; then
    ops_reset
    if ec="$(ops exit-config show --settlement "$SETTLEMENT_ID" --chain-id "$chain_id" 2>&1)"; then ec_ok=1; else ec_why="$(tail -1 <<<"$ec")"; fi
  fi
  if (( ec_ok )); then
    pass "exit config" "$(grep -E 'no exit config|exit_portal \(current\)|bridge_program \(current\)|pending_mask|activation_slot' <<<"$ec" | sed 's/^ *//; s/  */ /g' | paste -sd ';' - | sed 's/;/; /g')"
  else fail "exit config" "ExitConfigUnreadable: ${ec_why:-rome-zk-ops exit-config show failed}"; fi

  # Derive lag: the verifier node trails the sequencer by the batch still open and the one being posted. A gap of two
  # batches' worth of blocks that is not closing is a derive that has stopped.
  if needs sequencer reth-verifier derive; then
    if [[ -z "$ver2" ]]; then fail "derive lag" "VerifierUnreachable: no answer from $VERIFIER_RPC"
    elif [[ -z "$bn2" ]]; then skip "derive lag" "needs the sequencer's head, which could not be read"
    else
      local gap=$(( bn2 - ver2 )) limit=$(( 2 * bpb ))
      if (( gap < limit )) || { [[ -n "$ver1" ]] && (( ver2 > ver1 )); }; then
        pass "derive lag" "verifier at block $((ver2)), sequencer at $((bn2)) (gap $gap, limit $limit)"
      else fail "derive lag" "DeriveBehind: verifier at block $((ver2)), sequencer at $((bn2)) (gap $gap, limit $limit) and the verifier did not advance"; fi
    fi
  else
    needs sequencer reth-verifier derive || true
    skip "derive lag" "needs $MISSING, which is not running"
  fi

  # Verifier peers: derive feeds the verifier over the Engine API, so it never needs a peer. A peer means peer discovery
  # is on and the node has joined a public network, which cloud providers flag as cryptocurrency activity.
  if needs reth-verifier; then
    local peers; peers="$(rpc "$VERIFIER_RPC" net_peerCount)"
    if [[ -z "$peers" ]]; then fail "verifier peers" "VerifierUnreachable: net_peerCount gave no answer from $VERIFIER_RPC"
    elif (( peers == 0 )); then pass "verifier peers" "none (peer discovery is off)"
    else fail "verifier peers" "VerifierHasPeers: $((peers)) peers; reth-verifier must run with --disable-discovery --max-outbound-peers 0 --max-inbound-peers 0"; fi
  else
    needs reth-verifier || true
    skip "verifier peers" "needs $MISSING, which is not running"
  fi

  echo "== rollup check :: $( (( FAILED == 0 )) && echo ALL PASS || echo SOME FAILED ) =="
  exit "$FAILED"
}

usage() { sed -n '2,/^set -uo/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//'; }

cmd="${1:-}"; shift || true
case "$cmd" in
  init) cmd_init "$@" ;;
  register) cmd_register "$@" ;;
  guest-build) cmd_guest_build "$@" ;;
  up) cmd_up "$@" ;;
  check) cmd_check "$@" ;;
  down) cmd_down "$@" ;;
  logs) cmd_logs "$@" ;;
  status) cmd_status "$@" ;;
  refund-deposit) cmd_refund_deposit "$@" ;;
  exit-config) cmd_exit_config "$@" ;;
  vault) cmd_vault "$@" ;;
  release-exit) cmd_release_exit "$@" ;;
