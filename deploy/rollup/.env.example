# Copy to .env and edit. `./rollup init` reads this file; nothing here is rendered into the compose file except what
# init writes into rendered/compose.env.

# A Solana RPC endpoint for the cluster your chain settles on. Use a provider you trust: the batcher and derive make
# steady requests, and the public endpoints rate-limit them. Some providers put an API key in the URL; init writes
# the URL into rendered/batcher.toml and rendered/derive.toml, so keep rendered/ out of version control.
SOLANA_RPC_URL=https://api.devnet.solana.com

# The published program addresses for that cluster (a JSON file: cluster plus the program ids).
PROGRAMS_JSON=programs.devnet.json

# Key files, as paths (never the keys themselves). Both must be readable by uid 999, the user inside the containers.
#   SEQUENCER_KEY_PATH  the sequencer's signing key: 64 hex characters in a file
#   PAYER_KEYPAIR_PATH  a Solana keypair (JSON) funded with SOL; it pays Solana fees and rent and is the chain authority
SEQUENCER_KEY_PATH=./keys/sequencer.key
PAYER_KEYPAIR_PATH=./keys/payer.json

# Who can reach the sequencer's RPC (8545 and 8546). 127.0.0.1 keeps it on this machine; use 0.0.0.0 only behind a
# firewall or a TLS proxy you manage. Every other port is always loopback-only.
RPC_BIND=127.0.0.1

# The node image. Public tags are pinned to the commit of the source export they were built from, so a tag names exactly
# one tree: set ROME_ZK_TAG to the tag in your release notes. `./rollup up` refuses to start until this is set. To run an
# image you built from this tree yourself, set ROME_ZK_IMAGE to its full reference instead.
ROME_ZK_TAG=
# ROME_ZK_IMAGE=

# Settlement needs one NVIDIA GPU with more than 30 GB of memory and about 55 GB of proving keys on the host.
# The final proof step needs about 30 GB of GPU memory; a 24 GB card is not enough. Enable with PROVER=on.
# PROVER=on
# VKEY_JSON=./vkey.json       your verification-key file; its elf_sha256 names the guest binary below
# ELF_DIR=./elf               holds <elf_sha256>.elf, the guest binary you built
# ZISK_HOME=/opt/zisk         the downloaded proving keys
# PROVER_KEYS_MANIFEST=./prover/keys.sha256   the hashes your proving keys are checked against before every start
