# The pins of the downloads that setup-prover-host.sh checks itself for ZisK 1.3.1-alpha. Plain KEY=VALUE lines: nothing
# here is expanded by a shell. The ziskup sha256 and the commit of the release are in
# ../guest-build/zisk/1.3.1-alpha.env; this file holds what only the prover host downloads or installs.
#
# ARCHIVE_SHA256 and ARCHIVE_PLONK_SHA256 are the sha256 of the two key archives in the ZisK setup bucket
# (zisk-provingkey-1.3.1-alpha.tar.gz, about 5.1 GB; zisk-provingkey-plonk-1.3.1-alpha.tar.gz, about 21.9 GB). The setup
# script downloads both and checks them before it unpacks either.
#
# GPU_CARGO_ZISK_SHA256 and GPU_CARGO_ZISK_DEV_SHA256 are the sha256 of the files bin/cargo-zisk-gpu and
# bin/cargo-zisk-dev-gpu inside the release's binary archive (cargo_zisk_linux_amd64.tar.gz, whose own sha256 is
# CARGO_ZISK_SHA256 in the guest-build pin file). ziskup installs them as bin/cargo-zisk and bin/cargo-zisk-dev under
# ZISK_HOME, and the setup script checks them there before it runs either.
ARCHIVE_SHA256=fbd1679b0209db922254d27706ced05fe2890aad1e29311b05110cc5ec91d113
ARCHIVE_PLONK_SHA256=1ba770d09f3685004f7ff3b5a88a21f7147aaaf0056da9223ddaf8f19da18af6
GPU_CARGO_ZISK_SHA256=2a85e8a4dd7fe75d88740abb68b1c91b6f27aa74b82580c5c35d2dee4ebe26fe
GPU_CARGO_ZISK_DEV_SHA256=726b709b5ab8f7d7975b5c4d22f7ca957056b6c759bf94dd45ff00063c621ca2
