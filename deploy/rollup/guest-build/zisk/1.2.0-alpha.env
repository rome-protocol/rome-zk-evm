# The pins of one ZisK release, read by the guest-build Dockerfile and by guest-build.sh inside the image. Plain KEY=VALUE
# lines: nothing here is expanded by a shell. The file is named after the release it pins.
#
# ZISK_SCHEME is the number this release has in a chain's registry entry. Numbers are never reused.
# Every download is checked against its sha256 before it is used. ROOT_C_VADCOP_FINAL is the root of the vadcop_final
# verification key in this release's key set: the four 64-bit limbs of vadcop_final.verkey.json as one 32-byte big-endian
# number. It is a property of the key set, the same for every guest.
ZISK_VERSION=1.2.0-alpha
ZISK_SCHEME=1
ZISK_COMMIT=fbbc69bcd2ea9a78d1a438b4a897bc48ff0b00a3
ZISKUP_URL=https://raw.githubusercontent.com/0xPolygonHermez/zisk/v1.2.0-alpha/ziskup/ziskup
ZISKUP_SHA256=7473ab9181d69727838ed45e129c045e8016038b5bd2963dbfabc23a382d5a43
ZISK_TOOLCHAIN_TAG=zisk-3.0.0
ZISK_TOOLCHAIN_URL=https://github.com/0xPolygonHermez/rust/releases/download/zisk-3.0.0/rust-toolchain-x86_64-unknown-linux-gnu.tar.gz
ZISK_TOOLCHAIN_SHA256=74190d265b2d8f10424cdf666b71a5b5670c3a685785cd668ee5f49318fa149e
CARGO_ZISK_URL=https://github.com/0xPolygonHermez/zisk/releases/download/v1.2.0-alpha/cargo_zisk_linux_amd64.tar.gz
CARGO_ZISK_SHA256=e3605dafb5fcdb2fa8271ea945334694f42704737f31ef0bdf93d663f2b14866
ROOT_C_VADCOP_FINAL=0x564c2b1bcbd5932c81cfad1fa786a98372eb3d6495257c2d944544334f84382f
