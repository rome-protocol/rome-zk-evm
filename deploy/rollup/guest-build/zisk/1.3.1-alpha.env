# The pins of one ZisK release, read by the guest-build Dockerfile and by guest-build.sh inside the image. Plain KEY=VALUE
# lines: nothing here is expanded by a shell. The file is named after the release it pins.
#
# ZISK_SCHEME is the number this release has in a chain's registry entry. Numbers are never reused.
# Every download is checked against its sha256 before it is used. ROOT_C_VADCOP_FINAL is the root of the vadcop_final
# verification key in this release's key set: the four 64-bit limbs of vadcop_final.verkey.json as one 32-byte big-endian
# number. It is a property of the key set, the same for every guest.
ZISK_VERSION=1.3.1-alpha
ZISK_SCHEME=2
ZISK_COMMIT=306a9c934ba4947b1d586d69b67120f8b4c41466
ZISKUP_URL=https://raw.githubusercontent.com/0xPolygonHermez/zisk/v1.3.1-alpha/ziskup/ziskup
ZISKUP_SHA256=a2d1781f64f31719ef251f55a48c664ab35cdb7431d42167894f94b5fbec64e1
ZISK_TOOLCHAIN_TAG=zisk-4.0.0
ZISK_TOOLCHAIN_URL=https://github.com/0xPolygonHermez/rust/releases/download/zisk-4.0.0/rust-toolchain-x86_64-unknown-linux-gnu.tar.gz
ZISK_TOOLCHAIN_SHA256=c4c44b5612dd025f630c2f984ae5f8a862b885c4b14bfc57c980eb8073b8cf62
CARGO_ZISK_URL=https://github.com/0xPolygonHermez/zisk/releases/download/v1.3.1-alpha/cargo_zisk_linux_amd64.tar.gz
CARGO_ZISK_SHA256=13e590784e79a195db7e85465eef75e0820be7148d12f829e478047542aadef8
ROOT_C_VADCOP_FINAL=0xc3f12b9f8707c6a1e96df2bf6702c2ebdfbafedabeac654644a380befe091ac4
